PORT=5001
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.upjnplq.mongodb.net/KinBech?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=KinBech
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=5
NODE_ENV=development
CLIENT_ORIGIN=*

# Local MongoDB — set this so `make run` uses mongod on :27017 instead of Atlas
MONGODB_LOCAL_URI=mongodb://localhost:27017/KinBech